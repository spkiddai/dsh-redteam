{
  "name": "@prism-ai/dsh-redteam",
  "version": "1.3.2",
  "description": "A single DeepSeek Harness plugin for scoped red-team repository assessment",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dsh-redteam": "./dist/cli.js",
    "dsh-redteam-mcp": "./tools/dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./tools/plugin": {
      "types": "./tools/dist/plugin.d.ts",
      "default": "./tools/dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/cli.js",
    "dist/index.js",
    "dist/client.js",
    "dist/client.js.map",
    "dist/lib/**/*.js",
    "dist/plugins/**/*.js",
    "dist/**/*.d.ts",
    "tools/dist/**/*.js",
    "tools/dist/**/*.d.ts",
    "!tools/README.md",
    "!doc/**",
    "preset/**/*.yml",
    "deploy/**/*.yml",
    "deploy/knowledge/.env.example",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.build.json && tsc -p tools/tsconfig.build.json && tsdown",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src tests tools/src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tools/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm pack --dry-run",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fflate": "^0.8.2",
    "tldts": "^6.1.86",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-agent-presets": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-agent-presets": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@types/node": "^24.10.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@testing-library/react": "^16.3.0",
    "@vitest/coverage-v8": "^4.0.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "jsdom": "^26.1.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
